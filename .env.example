# Ejemplo de configuracion del backend FastAPI (backend/app).
# Copiar a .env y completar. El archivo .env esta ignorado por Git.
# NO contiene secretos reales: los valores de abajo son ejemplos publicos no utilizables.
# Generar un JWT_SECRET propio con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Aplicacion ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/soc.db
TIMEZONE=America/Asuncion

# --- Secretos (obligatorios, sin valor por defecto) ---
# JWT_SECRET: obligatorio. Minimo 32 caracteres. La app no arranca si falta.
JWT_SECRET=
# SECRET_KEY: opcional. Si se define, tambien debe ser unico y de 32+ caracteres.
SECRET_KEY=

# --- Bootstrap del usuario inicial (opcional) ---
# El usuario inicial solo se crea si AMBAS variables estan definidas.
# No sobrescribe usuarios existentes y siempre exige cambio de contrasena.
# Dejar vacias para no crear ningun usuario.
INITIAL_USER=
INITIAL_PASSWORD=

# --- Limites y otros ---
MAX_UPLOAD_MB=50
MAX_ROWS=200000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- GeoIP (opcional) ---
GEOIP_DB_PATH=./data/geoip/GeoLite2-City.mmdb
GEOIP_API_KEY=