# Ejemplo de configuracion del backend FastAPI (backend/app).
# Copiar este archivo como .env y completar los valores necesarios.
# .env esta ignorado por Git y NO debe subirse al repositorio.

# --- Aplicacion ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
TIMEZONE=America/Asuncion

# DATABASE_URL es opcional.
# Si se omite, el backend utiliza data/soc.db dentro del proyecto.
# DATABASE_URL=sqlite:///data/soc.db

# --- Seguridad ---
# JWT_SECRET es obligatorio y debe tener al menos 32 caracteres.
# Generar uno propio, por ejemplo:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# SECRET_KEY es opcional. Si se utiliza, tambien debe ser unico
# y tener al menos 32 caracteres.
SECRET_KEY=

# --- Bootstrap del administrador inicial (opcional) ---
# El usuario inicial solo se crea cuando AMBAS variables estan configuradas.
# No existen credenciales predeterminadas.
# El usuario creado debe cambiar su contrasena en el primer acceso.
# Dejar ambas vacias para desactivar el bootstrap.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# --- Limites ---
MAX_UPLOAD_MB=50
MAX_ROWS=200000

# --- CORS ---
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- GeoIP (opcional) ---
GEOIP_DB_PATH=./data/geoip/GeoLite2-City.mmdb
GEOIP_API_KEY=